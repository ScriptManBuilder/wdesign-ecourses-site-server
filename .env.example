# Database Configuration - Python Learning Project
DATABASE_URL="postgresql://username:password@localhost:5432/python_learning_db?schema=public"

# JWT Configuration - Unique for Python Learning
JWT_SECRET="your_unique_jwt_secret_here"
JWT_EXPIRES_IN="7d"

# Server Configuration - Different port from other projects
PORT=3003
NODE_ENV=development

# CORS Configuration - Python Learning domains
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3003,https://python-learning.com,https://www.python-learning.com,https://api.python-learning.com"

# Application Settings
APP_NAME="Python Learning Server"
APP_VERSION="1.0.0"

# Email Configuration - Python Learning
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="noreply@python-learning.com"
SMTP_PASS="your_app_password_here"

# File Upload Settings
MAX_FILE_SIZE=10485760
UPLOAD_FOLDER="uploads"

# Security Settings - Unique for Python Learning
BCRYPT_ROUNDS=12
SESSION_SECRET="your_unique_session_secret_here"

# API Keys - Python Learning specific
API_KEY="your_api_key_here"